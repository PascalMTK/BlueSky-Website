{
  "name": "bluesky-static-assets",
  "private": true,
  "description": "Local/CI-only Tailwind build for the Django app's static CSS. Never installed or run on PythonAnywhere.",
  "scripts": {
    "build:css": "tailwindcss -i static_src/css/input.css -o static_src/css/output.css --minify",
    "watch:css": "tailwindcss -i static_src/css/input.css -o static_src/css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
