# Copy to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: leave DB_ENGINE unset (or =sqlite3) for local dev with no MySQL server.
# On PythonAnywhere, set DB_ENGINE=mysql and fill in the values from the Databases tab.
DB_ENGINE=sqlite3
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
